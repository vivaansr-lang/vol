module.exports = {
    name: "addmoney",
    description: "Give money to a user (role only)",

    async execute(message, args, client) {
        const roleId = "1428011378190454897"; // ← PUT YOUR ROLE ID HERE

        // Check role
        if (!message.member.roles.cache.has(roleId)) {
            return message.reply("You don't have permission to use this command.");
        }

        const target = message.mentions.users.first();
        const amount = parseInt(args[1]);

        if (!target || isNaN(amount)) {
            return message.reply("Usage: !addmoney @user amount");
        }

        // 🔧 THIS PART depends on your database
        const data = await client.db.get(`money_${target.id}`) || 0;

        await client.db.set(`money_${target.id}`, data + amount);

        message.channel.send(`Gave ${amount} coins to ${target.username}`);
    }
};
